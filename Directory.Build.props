<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <InvariantGlobalization>true</InvariantGlobalization>
    <NoWarn></NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>imadyTech</Authors>
    <Company>imadyTech</Company>
    <Product>nebuRedaction</Product>
    <Copyright>Copyright 2026 imadyTech</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/imadyTech/NebuRedaction</PackageProjectUrl>
    <RepositoryUrl>https://github.com/imadyTech/NebuRedaction</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <VersionPrefix>0.1.0</VersionPrefix>
  </PropertyGroup>

</Project>
